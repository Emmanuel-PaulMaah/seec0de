# seec0de billing service
# Copy to .env and load it with your process manager, or export these variables.
# With no BACHS_API_KEY the service runs in mock mode.

PORT=8787
PUBLIC_BASE_URL=http://127.0.0.1:8787

# Bachs
BACHS_API_KEY=sk_sandbox_xxx
BACHS_API_BASE=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_xxx

# Product ids from the Bachs dashboard. Subscriptions need a monthly/yearly
# billing_cycle; NGN passes are one-time products.
BACHS_PRODUCT_PRO_MONTHLY_USD=prod_xxx
BACHS_PRODUCT_PRO_ANNUAL_USD=prod_xxx
BACHS_PRODUCT_PRO_30D_NGN=prod_xxx
BACHS_PRODUCT_PRO_ANNUAL_NGN=prod_xxx

# Managed AI (Pro users without their own Gemini key)
GEMINI_API_KEY=AIza_xxx
MANAGED_AI_MONTHLY_LIMIT=300

# Storage and licensing
BILLING_DATA_DIR=./data
LICENSE_GRACE_DAYS=7
CHECKOUT_RATE_LIMIT=30
